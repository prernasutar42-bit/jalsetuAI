# Database (Supabase PostgreSQL URL or leave empty for local SQLite)
DATABASE_URL=

# JWT Secrets
JWT_SECRET=super-secret-floodwatch-key-change-in-prod-123456
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Machine Learning
MODEL_PATH=ml/models/flood_model.joblib

# Scheduled Forecast & Alerting
PREDICTION_INTERVAL_MINUTES=30
ALERT_THRESHOLD=0.75
ALERT_EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@floodwatch.maharashtra.gov.in

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default Admin User
ADMIN_EMAIL=admin@floodwatch.test
ADMIN_PASSWORD=Admin@123
